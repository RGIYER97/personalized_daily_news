# ==============================================
# Daily News Briefing — Environment Variables
# Copy this file to .env and fill in your values
# ==============================================
# RSS feeds (WSJ, CNBC, NPR, BBC, NYT, Google News) need NO keys — they are public.
# Only NEWSAPI_KEY and GEMINI_API_KEY go here (plus email/SMS below).

# --- News API (https://newsapi.org — free tier: 100 req/day) ---
NEWSAPI_KEY=

# --- Google Gemini API (https://aistudio.google.com/apikey — free tier available) ---
# Required for blunt summaries (news + stocks). Without it, output is mostly raw headlines.
GEMINI_API_KEY=

# Groq (https://console.groq.com) — free API, separate quota when Gemini hits 429/404
GROQ_API_KEY=
# Set to false to try Groq before Gemini when Google quota is exhausted
# LLM_GEMINI_FIRST=true

# --- Email settings ---
# For Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
USER_EMAIL=you@example.com
SMTP_EMAIL=you@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Schedule (24hr format, EST timezone — only used for local `python main.py`) ---
SEND_TIME=07:00

# --- Weather (defaults to Harrison, NJ — override with any lat/lon) ---
# WEATHER_LAT=40.7459
# WEATHER_LON=-74.1543
# WEATHER_CITY_NAME=Harrison, NJ

# --- Apple Calendar (iCloud CalDAV) ---
# Generate an app-specific password at https://appleid.apple.com → Security → App-specific passwords
# Use your full Apple ID email and the app-specific password (not your Apple ID password)
APPLE_ID=you@icloud.com
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
